{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"dev"
			],
			"port": 5180
		},
		{
			"name": "controller",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"dev",
				"-w",
				"@mv/controller"
			],
			"port": 5181
		},
		{
			"name": "drum-judge",
			"runtimeExecutable": "node",
			"runtimeArgs": [
				"bench/drumeval/judge/server.ts",
				"--session=bench/reports/drumeval/judge/current",
				"--port=5199"
			],
			"port": 5199
		}
	]
}
